# Copy to .env and fill in. docker compose loads this file into the container.

# Required: OpenRouter key for the AI assistant (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Required in production: signs the session cookies. Without it a public default is used,
# and anyone could forge a session. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# then uncomment the line below and paste it in. Never leave it set but empty: an empty
# value is used as the key. Changing it signs everyone out.
# SESSION_SECRET=
